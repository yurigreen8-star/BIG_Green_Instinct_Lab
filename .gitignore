# Кэш Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Виртуальные окружения
venv/
.venv/
env/

# Настройки редактора
.vscode/
.idea/

# Результаты экспериментов: по умолчанию игнорируются (большие файлы)
results/*
!results/.gitkeep

